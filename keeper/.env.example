# Copy to .env (gitignored). Placeholder values only.
# Devnet only: the config rejects any other cluster until the project rules change.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=postgres://user:password@localhost:5432/breaks
# Only "mock" exists until Phase 0 shows how Collector Crypt purchases work.
PACK_PROVIDER=mock
# How often the job runner wakes up, in milliseconds.
JOB_TICK_MS=5000

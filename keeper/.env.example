# Copy to .env (gitignored). Placeholder values only.
# Devnet only: the config rejects any other cluster until the project rules change.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=postgres://user:password@localhost:5432/breaks
# Only "mock" exists until Phase 0 shows how Collector Crypt purchases and card transfers work. The mock keeps its
# pretend chain in memory: use it to watch the flow on devnet, not to keep state across restarts.
PACK_PROVIDER=mock
CARD_TRANSFER=mock
# What the mock pack provider charges per pack, in micro-USDC (25 USDC).
MOCK_PACK_PRICE=25000000
# How often the job runner wakes up, and how often each job runs when it does, in milliseconds.
JOB_TICK_MS=5000
JOB_INTERVAL_MS=10000

# The keeper's signing key: a Solana CLI keypair file (JSON array of bytes), kept OUTSIDE the repo and never
# committed. It is a hot wallet that can only advance the break state machine; fund it with a little devnet SOL.
KEEPER_KEYPAIR_PATH=/path/to/keeper-keypair.json
# What counts as landed for sends and reads: confirmed (default) or finalized.
SOLANA_COMMITMENT=confirmed

# The deployed programs (these are the placeholder ids from the repo until the devnet deployment).
BREAKS_PROGRAM_ID=8tmJjCG3D4TF7oPiPWNoaCjZ4pN2U4H237BSGVw2B8KU
TREASURY_PROGRAM_ID=Bvq3U9fz2MiHkLH8u4zyt6T1bimxnaEuHkZhezNDT5R9
# Randomness. The VRF program must be the one the breaks program is configured with (ORAO's address by default).
VRF_PROGRAM_ID=VRFzZoJdhFWL8rkvu87LpKM3RbcVezpMEc6X5GVDr7y
# ORAO's fee treasury is read from the VRF program's network state each time a randomness request is made, so there is
# nothing to copy in. The keeper pays ORAO's fee (and the rent of the request account) in SOL from its own wallet.

# Free-spot eligibility, in token base units (a pump.fun token has 6 decimals, so 1M tokens = 1000000000000).
# The minimum is an open decision; it has no default.
MIN_TWAB=1000000000000
# Largest weight one wallet can have. Leave it out for no cap. Pending decision A2: a cap rewards splitting a balance
# over many wallets.
# WEIGHT_CAP=
# The balance indexer must have read this many seconds past the end of a break's window before its list is computed.
INDEXER_SETTLE_SECS=120

# The token whose holders get free spots (its mint address). Required: the keeper refuses to start if this is not an
# initialized mint on the cluster, because with a wrong address every eligibility list would be empty.
TOKEN_MINT=REPLACE_WITH_THE_TOKEN_MINT_ADDRESS
# The balance indexer reads every transfer of the token with plain JSON-RPC from SOLANA_RPC_URL (finalized data only),
# starting at the mint. It reads each holder again at least every INDEXER_INTERVAL_SECS seconds, and at once when a
# break's window has ended. A pass only claims what happened INDEXER_LAG_SECS before it started (finalization lag).
INDEXER_INTERVAL_SECS=900
INDEXER_LAG_SECS=120
# Node calls per run (a page of signatures or one transaction each), signatures per page, transactions fetched at once.
# A page is read whole, so a run is a few pages: these defaults are about 6 calls a second with bursts of 4. Lower them on
# a node with tight rate limits; raise them to catch up faster on a busy token.
INDEXER_CALLS_PER_RUN=60
INDEXER_PAGE_SIZE=25
INDEXER_CONCURRENCY=4

# The break the scheduler creates when the treasury can pay for its worst case. These numbers are open decisions (CLAUDE.md):
# the values below are placeholders (a $20 spot, $25 packs, a 12 hour sale), not recommendations. Prices are micro-USDC.
# Set BREAK_AUTO_CREATE=false to create no break automatically (breaks made by hand with the keeper key are still picked up).
BREAK_AUTO_CREATE=true
BREAK_PAID_SPOTS=10
BREAK_FREE_SPOTS=2
BREAK_SPOT_PRICE=20000000
# The packs of the break, one per spot (so the counts add up to BREAK_PAID_SPOTS + BREAK_FREE_SPOTS), as a JSON list of
# groups: a Collector Crypt machine (text of up to 32 bytes, or 0x and 64 hex digits for a raw 32-byte id), the most one
# pack from it may cost, and how many of the break's packs come from it. Committed on-chain for the whole break. Keep the
# single quotes. The groups are put in order, cheapest first: a break that does not fill drops its most expensive packs, and
# the spot price may not be above the average pack price. A mix looks like this (12 spots):
#   BREAK_PACKS='[{"machine":"pokemon-10","maxPrice":"10000000","count":6},{"machine":"pokemon-25","maxPrice":"25000000","count":4},{"machine":"grail-50","maxPrice":"50000000","count":2}]'
BREAK_PACKS='[{"machine":"pokemon-25","maxPrice":"25000000","count":12}]'
# How long the sale (and the TWAB window) lasts, in seconds. The breaks program only accepts its configured min..max.
BREAK_WINDOW_SECS=43200

# The fee sweep deposits the USDC in the KEEPER's wallet (its associated USDC account) into the treasury, which splits it
# between the subsidy and holder buckets. Anyone may deposit. It moves money, so it is off until you turn it on.
# Fee money has to get into the keeper's wallet first: how (a transfer approved by the multisig, or a Squads spending
# limit for the keeper) is an open decision, and the keeper does not do it. The keeper's USDC account must exist.
SWEEP_ENABLED=false
# Nothing smaller than this (base units of USDC, 1000000 = $1) is deposited: each deposit costs a transaction fee.
SWEEP_MIN_DEPOSIT=1000000
# Only "none" exists: swapping SOL to USDC needs Jupiter, which is a mainnet service and this project is devnet only.
# Without a swap provider the sweep only deposits USDC that is already in the wallet. The limits below are for the swap
# and do nothing yet: the SOL (lamports) the wallet always keeps, the smallest and largest swap, the slippage allowed in
# basis points, and an optional floor (base units of USDC for one whole SOL) below which nothing is swapped.
SWEEP_SWAP_PROVIDER=none
SWEEP_KEEP_LAMPORTS=1000000000
SWEEP_MIN_LAMPORTS=100000000
SWEEP_MAX_LAMPORTS=10000000000
SWEEP_SLIPPAGE_BPS=50
# SWEEP_MIN_USDC_PER_SOL=

# Where the public lists are written: each break's eligible wallets (eligibility/<root>.json) and, once the seed is final,
# its cards (pool/<pool hash>.json), named by the hashes the chain committed so anyone can check a file against the chain.
# A file is only written when the keeper's data hashes to what the chain (at finalized) committed. Serve the directory over
# https from any static host, with CORS open to the site. Off without PUBLISH_DIR. See docs/PUBLISHED.md.
# PUBLISH_DIR=/var/www/published
PUBLISH_INTERVAL_SECS=60

# The X bot announces, from finalized chain data only, how far the next break's reserve is (at the milestones below),
# that a sale is live, how many spots are left near the end, who won the free spots and the results. It is off until
# you turn it on. BOT_POSTER=log is a dry run: it only writes each post to the log, with no account and no credentials.
# BOT_POSTER=x posts as the account the four X_* values belong to (OAuth 1.0a user keys; keep them out of git). Check the
# plan, the price per post and the account's write permission in X's developer console first, and label the account as
# automated in its settings. Every post is saved before it is sent, so a restart never repeats one.
BOT_ENABLED=false
BOT_POSTER=log
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_API_BASE=https://api.x.com
# How often the bot looks (seconds), the least time between two posts, and the most posts in 24 hours.
BOT_INTERVAL_SECS=60
BOT_MIN_GAP_SECS=60
BOT_MAX_POSTS_PER_DAY=20
# A post that got no verdict from X is sent again, with the same text, after (sends so far x this many) seconds, and
# given up after this many sends.
BOT_RETRY_STEP_SECS=120
BOT_MAX_ATTEMPTS=5
# The next break's reserve is announced at these percentages (whole numbers from 1 to 99, rising). Spots left are
# announced this many hours before the sale ends (whole hours; only those within half the sale's length are used).
BOT_MILESTONES=25,50,75
BOT_REMINDER_HOURS=3,1
# How many of the latest breaks are looked at, and how many seconds after the last card is delivered the results are posted.
BOT_LOOKBACK_BREAKS=5
BOT_FINALITY_MARGIN_SECS=120
# Where the results page will be (https). The results post links to <BOT_SITE_URL>/breaks/<number>; without it, no link.
# BOT_SITE_URL=

{
  "name": "keeper",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.9" },
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "phase0": "tsx src/phase0/main.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@scure/base": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
